<Project>
  <!--
    Imported after each project body, so it sees the IsPackable a csproj sets; Directory.Build.props is imported before the
    body and would not.
    On GitHub Actions the build is deterministic, so Source Link maps the PDBs to the repository's commit, not to the runner's
    paths. Only the packable projects get it. Test projects stay out: deterministic paths turn CallerFilePath into /_/...,
    which breaks tests that read the source tree.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' And '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
