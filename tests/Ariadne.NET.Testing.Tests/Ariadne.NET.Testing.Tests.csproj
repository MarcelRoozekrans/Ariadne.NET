<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.7.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!--
      A project reference skips the buildTransitive targets of Ariadne.NET.Workspaces, so this project keeps the two
      references they replace for a package consumer; see the Workspaces README.
    -->
    <PackageReference Include="Microsoft.Build.Framework" Version="18.7.1" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.7.1" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ariadne.NET.Testing\Ariadne.NET.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\FixtureProjects.cs" Link="Shared\FixtureProjects.cs" />
    <Compile Include="..\Shared\StrayFiles.cs" Link="Shared\StrayFiles.cs" />
    <Compile Include="..\Ariadne.NET.Tests\Reports\SarifSchema.cs" Link="Reports\SarifSchema.cs" />
    <None Include="..\Ariadne.NET.Tests\Reports\sarif-schema-2.1.0.json" Link="Reports\sarif-schema-2.1.0.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
