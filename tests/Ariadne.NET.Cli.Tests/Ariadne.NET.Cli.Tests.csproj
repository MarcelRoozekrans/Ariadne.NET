<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- A project reference skips the buildTransitive targets of Ariadne.NET.Workspaces, so these two stay; see its README. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="18.12.2" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.12.2" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Ariadne.NET.Tests.Shared" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\UnixFactAttribute.cs" Link="Shared\UnixFactAttribute.cs" />
    <Compile Include="..\Shared\UnixNonRootFactAttribute.cs" Link="Shared\UnixNonRootFactAttribute.cs" />
    <Compile Include="..\Shared\FixtureProjects.cs" Link="Shared\FixtureProjects.cs" />
    <Compile Include="..\Shared\StrayFiles.cs" Link="Shared\StrayFiles.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ariadne.NET.Cli\Ariadne.NET.Cli.csproj" />
  </ItemGroup>

</Project>
