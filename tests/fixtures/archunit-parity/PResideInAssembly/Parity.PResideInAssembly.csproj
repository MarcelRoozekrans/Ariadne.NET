<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reside-in-assembly needs a second assembly: Other/ is its own project, so this one leaves it out of its sources. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);Other/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Other/Parity.PResideInAssembly.Other.csproj" />
  </ItemGroup>

</Project>
