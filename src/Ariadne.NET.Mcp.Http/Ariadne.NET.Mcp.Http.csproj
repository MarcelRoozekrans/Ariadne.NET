<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Ariadne.NET\Ariadne.NET.csproj" />
    <ProjectReference Include="..\Ariadne.NET.Mcp\Ariadne.NET.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A project reference skips the buildTransitive targets of Ariadne.NET.Workspaces, so these two stay; see its README. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="18.7.1" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.7.1" ExcludeAssets="runtime" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      The MCP HTTP host is deliberately not a package until Phase 5.1. The Web SDK warns when a non-packable web project is
      packed; the release pack still packs the whole solution, so the inspection catches a project turning packable by accident.
    -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>

</Project>
