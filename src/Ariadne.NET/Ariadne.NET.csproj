<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Ariadne.NET</PackageId>
    <Description>Pluggable, pattern-agnostic architecture governance engine. Enforces structural rules for AI code generation via declarative YAML rule packs.</Description>
    <Authors>Marcel Roozekrans</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MarcelRoozekrans/architecture-governance-engine</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The generated registration is internal; the public AddAriadneNETServices wraps it and adds the git client proxy. -->
    <ZeroAllocGeneratedAccessibility>Internal</ZeroAllocGeneratedAccessibility>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ariadne.NET.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ariadne.NET.Abstractions\Ariadne.NET.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="ZeroAlloc.Inject" Version="1.11.6" />
    <PackageReference Include="ZeroAlloc.Inject.Generator" Version="1.11.6" />
    <PackageReference Include="ZeroAlloc.Resilience" Version="3.4.0" />
    <PackageReference Include="ZeroAlloc.Telemetry" Version="1.12.7" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BuiltinPacks\*.yaml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
