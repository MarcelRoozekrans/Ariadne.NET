<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <!-- A project reference skips the buildTransitive targets of Ariadne.NET.Workspaces, so these two stay; see its README. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="18.12.2" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.12.2" ExcludeAssets="runtime" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.2" />
    <PackageReference Include="ZeroAlloc.Inject" Version="1.12.0" />
    <PackageReference Include="ZeroAlloc.Inject.Generator" Version="1.12.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ariadne.NET\Ariadne.NET.csproj" />
    <ProjectReference Include="..\Ariadne.NET.Workspaces\Ariadne.NET.Workspaces.csproj" />
  </ItemGroup>

</Project>
