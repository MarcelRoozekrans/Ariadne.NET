<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ariadne.NET\Ariadne.NET.csproj" />
    <ProjectReference Include="..\Ariadne.NET.Workspaces\Ariadne.NET.Workspaces.csproj" />
    <ProjectReference Include="..\Ariadne.NET.Hooks\Ariadne.NET.Hooks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- Required by every project that references Ariadne.NET.Workspaces; see its README. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-rc.3.26522.148" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ariadne</ToolCommandName>
    <PackageId>Ariadne.NET.Cli</PackageId>
    <Description>The ariadne command: checks a .NET solution against its Ariadne.NET architecture rule packs, sets up a repository's rules and runs the Claude Code hooks.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ariadne.NET.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
